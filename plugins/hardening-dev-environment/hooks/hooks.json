{
  "description": "Hardens Claude Code session: PreToolUse blocks for credential-read Bash and package.json scripts tampering; PostToolUse trust-boundary reminder for non-vendor WebFetch results",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/sensitive-bash-guard.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/package-json-scripts-guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/untrusted-content-reminder.py"
          }
        ]
      }
    ]
  }
}
